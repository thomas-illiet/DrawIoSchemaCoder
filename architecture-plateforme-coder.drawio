        <mxCell id="p1_e_coders_workloads" value="Provisioning only · K8s API" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#EA580C;strokeWidth=2.5;dashed=1;endArrow=block;endFill=1;fontStyle=1;fontSize=14;fontColor=#EA580C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=0;entryY=0.45;" edge="1" parent="1" source="p1_coders" target="p1_workloads">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="p1_footer" value="&lt;b&gt;Key decisions&lt;/b&gt;&lt;br&gt;① Central cluster: control plane only; one in-house WAF and one Coder per Workload cluster. &amp;nbsp;&amp;nbsp; ② Caddy routes every instance through its dedicated WAF before Coder; the WAF restricts selected product functions. &amp;nbsp;&amp;nbsp; ③ Workspace access uses the Coder web page or access proxy; only the agent tunnel reaches Workload products. &amp;nbsp;&amp;nbsp; ④ L4 passthrough feeds Caddy TLS; Certis manages the certificate on the TLS LB before HAProxy. &amp;nbsp;&amp;nbsp; ⑤ Argo CD and Prometheus stop at the Workload boundary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=16;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=22;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="895" width="1800" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
