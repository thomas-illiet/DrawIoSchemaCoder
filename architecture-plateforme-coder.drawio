        <mxCell id="p7_footer" value="&lt;b&gt;Key points&lt;/b&gt;&lt;br&gt;① External PostgreSQL provides separate logical databases. &amp;nbsp;&amp;nbsp; ② Prometheus and Grafana use central-cluster Trident PVCs; HAProxy protects Prometheus with Basic Auth. &amp;nbsp;&amp;nbsp; ③ Central Prometheus collects no metrics from external Workload clusters. &amp;nbsp;&amp;nbsp; ④ Monitoring PVCs are independent from Workload-cluster storage options." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=16;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=22;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="925" width="1800" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
