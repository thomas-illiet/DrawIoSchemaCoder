        <mxCell id="p6_e_workspace_proxy" value="Optional proxy egress" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2.5;dashed=1;endArrow=block;endFill=1;fontStyle=1;fontSize=14;fontColor=#2563EB;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6_workspace" target="p6_corporate_proxy">
          <mxGeometry relative="1" x="0.4" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="800" />
              <mxPoint x="430" y="940" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p6_e_workspace_artifactory_direct" value="Direct development packages" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2.5;dashed=1;endArrow=block;endFill=1;fontStyle=1;fontSize=14;fontColor=#2563EB;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.25;entryY=1;" edge="1" parent="1" source="p6_workspace" target="p6_artifactory">
          <mxGeometry relative="1" x="0.58" as="geometry">
            <Array as="points">
              <mxPoint x="240" y="1015" />
              <mxPoint x="1470" y="1015" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p6_footer" value="&lt;b&gt;Key points&lt;/b&gt;&lt;br&gt;① Browser, add-on, and CLI access remains Coder-mediated; no user-to-pod path exists. &amp;nbsp;&amp;nbsp; ② Caddy routes every Coder request through its dedicated WAF; the WAF restricts selected product functions. &amp;nbsp;&amp;nbsp; ③ The Workspace agent initiates the tunnel through the same Caddy → WAF → Coder path. &amp;nbsp;&amp;nbsp; ④ Certis TLS LB and HAProxy publish Marketplace and the secretless Storage proxy. &amp;nbsp;&amp;nbsp; ⑤ Marketplace and Storage depend on Artifactory. &amp;nbsp;&amp;nbsp; ⑥ Workspaces may access Artifactory directly for development packages. &amp;nbsp;&amp;nbsp; ⑦ Workspaces may use the company-managed corporate proxy for outbound HTTP(S)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=16;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=22;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1080" width="1800" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
