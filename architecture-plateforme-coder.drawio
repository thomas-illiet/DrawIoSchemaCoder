        <mxCell id="p6w_shutdown_policy" value="&lt;b&gt;Daily Workspace compute stop&lt;/b&gt;&lt;br&gt;All running Workspace containers are stopped automatically at 00:00&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;&lt;b&gt;Goal · Reduce infrastructure consumption&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=16;fontColor=#065F46;align=left;verticalAlign=middle;spacingLeft=78;spacingRight=24;spacingTop=12;spacingBottom=12;" vertex="1" parent="p6w_cluster">
